HOST=127.0.0.1
PORT=8765
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=eosdo
# Optional isolated Compose instance: use a unique project name and free ports.
# COMPOSE_PROJECT_NAME=eosdo-local
# POSTGRES_PORT=55432
# REDIS_PORT=56379
# MINIO_PORT=59000
# MINIO_CONSOLE_PORT=59001
DATABASE_URL=postgres://eosdo:replace-with-local-password@127.0.0.1:5432/eosdo
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_URL_STYLE=path
S3_BUCKET=eosdo
S3_ACCESS_KEY_ID=eosdo-local
S3_SECRET_ACCESS_KEY=replace-with-local-minio-password
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Optional: existing locally cached/private MinIO image; default builds official source.
# MINIO_IMAGE=eosdo-minio:2025-09-07
